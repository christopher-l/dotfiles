vortex {
	tls internal
	route {
		@denied not remote_ip private_ranges
		abort @denied
		respond / "Hello, world!"
		reverse_proxy /paperless/* localhost:3100
		reverse_proxy /files/* localhost:3110
		error 404
	}
}
